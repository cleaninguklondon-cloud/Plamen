# Sparkle Booking — copy to .env for local dev: cp .env.example .env

# App (Vite exposes VITE_* to the client)
VITE_APP_NAME=Sparkle Booking

# Deployment target (set VERCEL=1 only for Vercel builds; leave unset locally)
# VERCEL=1

# Stripe — add when payment is wired up (server-only keys must NOT use VITE_ prefix)
# STRIPE_SECRET_KEY=sk_test_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# GitHub — optional PAT for pushing to cleaninguklondon-cloud/Plamen from your machine
# GH_TOKEN=ghp_...
