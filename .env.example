# Plamen — copy to .env for local dev: cp .env.example .env

# App (Vite exposes VITE_* to the client)
VITE_APP_NAME=Plamen

# Deployment target (set VERCEL=1 only for Vercel builds; leave unset locally)
# VERCEL=1

# Stripe — add when payment is wired up (server-only keys must NOT use VITE_ prefix)
# STRIPE_SECRET_KEY=sk_test_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Vercel — from vercel.com/account/tokens (for CLI deploy)
# VERCEL_TOKEN=...

# GitHub — PAT from cleaninguklondon-cloud (repo scope) for origin pushes
# PLAMEN_GITHUB_TOKEN=ghp_...
# GH_TOKEN=ghp_...
